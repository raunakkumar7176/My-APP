<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ (API 33+): notifications require this runtime
         permission. On API < 33 the OS ignores it (notifications were
         never gated behind a runtime permission there) — declaring it is
         harmless and required either way for flutter_local_notifications /
         firebase_messaging's own permission check to function. The actual
         REQUEST (the system dialog) is triggered explicitly from Dart
         (PushNotificationService.requestPermissionWithRationale), never
         automatically on launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Camera/gallery for feedback screenshots and profile avatars
         (image_picker). READ_MEDIA_IMAGES is the Android 13+ (API 33+)
         replacement for the legacy READ_EXTERNAL_STORAGE gallery read. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- Required on Android 12+ (API 31+) for
         AndroidScheduleMode.exactAllowWhileIdle in
         AcademicAlarmService/PushNotificationService.scheduleExactNotification
         — without it the OS silently downgrades the alarm to inexact
         timing, which defeats the point of a routine-session alarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Required for the full-screen alarm intent
         (AndroidNotificationDetails.fullScreenIntent) on Android 14+
         (API 34+); on earlier versions this permission is a no-op. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <application
        android:label="My Preparation"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase email verification / auth callback deep link
                 (my-preparation://auth-callback) — see
                 AuthService.emailVerificationRedirectUrl. Not an https App
                 Link, so autoVerify is omitted on purpose. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="my-preparation" android:host="auth-callback"/>
            </intent-filter>
        </activity>
        <!-- Default FCM notification channel — used only for the rare
             notification+data message delivered before PushNotificationService
             has run (e.g. a very cold background delivery); every push this
             app actually sends targets one of the 6 named channels created
             at runtime (PushNotificationService._createChannels /
             lib/core/services/push_notification_service.dart), which is
             what the user sees in Android Settings → App notifications. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
