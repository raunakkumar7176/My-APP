<?xml version="1.0" encoding="utf-8"?>
<!-- Branded native launch screen: shown by the OS before the Flutter engine
     paints its first frame (which then shows the matching Dart-side
     SplashScreen with AppLogo). Colors mirror the auth surface's Neu.base
     background so there is no visible color jump between this screen and
     the Flutter splash that follows it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/branding_logo" />
    </item>
</layer-list>
